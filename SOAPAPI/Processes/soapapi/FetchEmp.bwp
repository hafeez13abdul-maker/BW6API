                                    <element maxOccurs="1" minOccurs="0"
                                    name="Lname" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="Salary" nillable="false" type="int"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="EmpID" nillable="false" type="int"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="Status" nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
